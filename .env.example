# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopee_products

# Shopee API
SHOPEE_PARTNER_ID=123456
SHOPEE_PARTNER_KEY=your_partner_key_here
SHOPEE_SHOP_ID=your_shop_id_here
# Use sandbox URL while app is in "Developing" status
# Production: https://partner.shopeemobile.com
SHOPEE_BASE_URL=https://openplatform.sandbox.test-stable.shopee.sg

# App
SHOPEE_REDIRECT_URL=http://localhost:8000/api/auth/callback
SYNC_INTERVAL_MINUTES=60
